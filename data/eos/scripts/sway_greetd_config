#!/usr/bin/env bash
set -euo pipefail

SOURCE_FILE="/usr/share/eos-settings-sway/config.toml"
DEST_DIR="/etc/greetd"
DEST_PATH="${DEST_DIR}/config.toml"

if pacman -Q eos-settings-sway &>/dev/null; then
    mkdir -p "${DEST_DIR}"

    # respect displaymanager written Autologin-Block
    initial=""
    if [ -f "${DEST_PATH}" ]; then
        initial=$(awk '/^\[initial_session\]/{f=1; print; next} /^\[/{f=0} f' "${DEST_PATH}")
    fi

    cp -f "${SOURCE_FILE}" "${DEST_PATH}"

    if [ -n "${initial}" ]; then
        printf '\n%s\n' "${initial}" >> "${DEST_PATH}"
    fi
fi
