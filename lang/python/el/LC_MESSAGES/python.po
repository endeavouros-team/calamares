#: src/modules/services-openrc/main.py:29
msgid "Configure OpenRC services"
msgstr "Διαμόρφωση υπηρεσιών OpenRC"

#: src/modules/services-openrc/main.py:57
msgid "Cannot add service {name!s} to run-level {level!s}."
msgstr ""
"Δεν είναι δυνατή η προσθήκη της υπηρεσίας {name!s} στο επίπεδο εκτέλεσης "
"{level!s}."

#: src/modules/services-openrc/main.py:59
msgid "Cannot remove service {name!s} from run-level {level!s}."
msgstr ""
"Δεν είναι δυνατή η αφαίρεση της υπηρεσίας {name!s} από το επίπεδο εκτέλεσης "
"{level!s}."

#: src/modules/services-openrc/main.py:61
msgid ""
"Unknown service-action <code>{arg!s}</code> for service {name!s} in run-"
"level {level!s}."
msgstr ""
"Άγνωστη ενέργεια <code>{arg!s}</code> για την υπηρεσία {name!s} στο επίπεδο "
"εκτέλεσης {level!s}."

#: src/modules/services-openrc/main.py:93
msgid "Cannot modify service"
msgstr "Δεν είναι δυνατή η τροποποίηση της υπηρεσίας"

#: src/modules/services-openrc/main.py:94
msgid ""
"<code>rc-update {arg!s}</code> call in chroot returned error code {num!s}."
msgstr ""
"Η κλήση <code>rc-update {arg!s}</code> στο chroot επέστρεψε τον κωδικό "
"σφάλματος {num!s}."

#: src/modules/services-openrc/main.py:101
msgid "Target runlevel does not exist"
msgstr "Το επίπεδο εκτέλεσης προορισμού δεν υπάρχει"

#: src/modules/services-openrc/main.py:102
msgid ""
"The path for runlevel {level!s} is <code>{path!s}</code>, which does not "
"exist."
msgstr ""
"Η διαδρομή για το επίπεδο εκτέλεσης {level!s} είναι <code>{path!s}</code>, "
"το οποίο δεν υπάρχει."

#: src/modules/services-openrc/main.py:110
msgid "Target service does not exist"
msgstr "Η υπηρεσία προορισμού δεν υπάρχει"

#: src/modules/services-openrc/main.py:111
msgid ""
"The path for service {name!s} is <code>{path!s}</code>, which does not "
"exist."
msgstr ""
"Η διαδρομή για την υπηρεσία {name!s} είναι <code>{path!s}</code>, το οποίο "
"δεν υπάρχει."

#: src/modules/services-systemd/main.py:26
msgid "Configure systemd units"
msgstr "Διαμόρφωση μονάδων systemd"

#: src/modules/services-systemd/main.py:64
msgid "Cannot modify unit"
msgstr "Δεν είναι δυνατή η τροποποίηση της μονάδας"

#: src/modules/services-systemd/main.py:65
msgid ""
"<code>systemctl {_action!s}</code> call in chroot returned error code "
"{_exit_code!s}."
msgstr ""
"Η κλήση <code>systemctl {_action!s}</code> στο chroot επέστρεψε τον κωδικό "
"σφάλματος {_exit_code!s}."

#: src/modules/services-systemd/main.py:66
msgid "Cannot {_action!s} systemd unit <code>{_name!s}</code>."
msgstr ""
"Δεν είναι δυνατή η εκτέλεση της ενέργειας {_action!s} στη μονάδα systemd "
"<code>{_name!s}</code>."

