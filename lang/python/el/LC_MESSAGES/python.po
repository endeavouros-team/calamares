#: src/modules/bootloader/main.py:46
msgid "Install bootloader."
msgstr "Εγκατάσταση φορτωτή εκκίνησης."

#: src/modules/bootloader/main.py:671
msgid "Failed to install grub, no partitions defined in global storage"
msgstr ""
"Αποτυχία εγκατάστασης του grub, δεν ορίστηκαν διαμερίσματα στον καθολικό "
"χώρο αποθήκευσης"

#: src/modules/bootloader/main.py:931
msgid "Bootloader installation error"
msgstr "Σφάλμα εγκατάστασης φορτωτή εκκίνησης"

#: src/modules/bootloader/main.py:932
msgid ""
"The bootloader could not be installed. The installation command "
"<pre>{!s}</pre> returned error code {!s}."
msgstr ""
"Δεν ήταν δυνατή η εγκατάσταση του φορτωτή εκκίνησης. Η εντολή εγκατάστασης "
"<pre>{!s}</pre> επέστρεψε τον κωδικό σφάλματος {!s}."

